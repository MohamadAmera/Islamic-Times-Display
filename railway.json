{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "node dist/index.cjs",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5,
    "healthcheck": {
      "type": "HTTP",
      "interval": 10,
      "timeout": 5,
      "retries": 3,
      "path": "/api/healthz",
      "port": 8080
    }
  }
}
